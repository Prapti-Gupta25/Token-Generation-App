<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- ✅ Internet permission (must be before <application>) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/token"
        android:label="@string/app_name"
        android:roundIcon="@drawable/token"
        android:supportsRtl="true"
        android:theme="@style/Theme.DigitalTokenGenerationApp"
        tools:ignore="ExtraText">
        <activity
            android:name=".TokenResetActivity"
            android:exported="false" />
        <!-- ✅ Google Mobile Ads Test App ID -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" /> <!-- ✅ Disable automatic Mobile Ads measurement (optional) -->
        <meta-data
            android:name="com.google.android.gms.ads.DELAY_APP_MEASUREMENT_INIT"
            android:value="true" /> <!-- ✅ All your activities -->
        <activity
            android:name=".TokenSuccessActivity"
            android:exported="false" />
        <activity
            android:name=".AdminDashboardActivity"
            android:exported="true" />
        <activity
            android:name=".TokenBookingActivity"
            android:exported="false" />
        <activity
            android:name=".PlaceSelectionActivity"
            android:exported="false" />
        <activity
            android:name=".UserRegisterActivity"
            android:exported="false" />
        <activity
            android:name=".AdminRegisterActivity"
            android:exported="false" />
        <activity
            android:name=".AdminLoginActivity"
            android:exported="false" />
        <activity
            android:name=".UserLoginActivity"
            android:exported="false" />
        <activity
            android:name=".HomeActivity"
            android:exported="false"
            tools:ignore="MissingClass" /> <!-- ✅ Launcher activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
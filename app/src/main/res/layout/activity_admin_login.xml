<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@drawable/gradient_bg"
    tools:context=".AdminLoginActivity">

    <!-- Title -->
    <TextView
        android:id="@+id/loginTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="@string/login_as_admin"
        android:textColor="@android:color/white"
        android:textSize="26sp"
        android:textStyle="bold" />

    <!-- Email Input -->
    <EditText
        android:id="@+id/emailInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:autofillHints="emailAddress"
        android:backgroundTint="@android:color/white"
        android:hint="@string/admin_email"
        android:inputType="textEmailAddress"
        android:minHeight="48dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="@android:color/white"
        android:textColorHint="#000000"
        tools:ignore="VisualLintTextFieldSize" />

    <!-- Password Input -->
    <EditText
        android:id="@+id/passwordInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:autofillHints="password"
        android:backgroundTint="@android:color/white"
        android:hint="@string/password"
        android:inputType="textPassword"
        android:minHeight="48dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="@android:color/white"
        android:textColorHint="#212121"
        tools:ignore="VisualLintTextFieldSize" />

    <!-- Spinner for selecting place -->
    <Spinner
        android:id="@+id/placeSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:background="@color/design_default_color_background"
        android:outlineAmbientShadowColor="@color/black"
        android:minHeight="48dp"
        android:padding="10dp"
        android:spinnerMode="dropdown"
        tools:ignore="UnusedAttribute" />

    <!-- Login Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/loginBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#E0B0FF"
        android:minHeight="50dp"
        android:text="@string/login_as_admin"
        android:textColor="#5E35B1"
        android:textSize="18sp"
        app:strokeColor="@android:color/white"
        app:strokeWidth="2dp"
        tools:ignore="DuplicateSpeakableTextCheck,MissingClass,VisualLintButtonSize" />

    <!-- Back Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/backBtn"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:minHeight="48dp"
        android:strokeColor="@android:color/white"
        android:text="@string/back"
        android:textColor="#212121"
        android:textSize="18sp"
        tools:ignore="MissingClass,VisualLintButtonSize" />

    <!-- Register Text -->
    <TextView
        android:id="@+id/registerText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:minHeight="48dp"
        android:text="@string/register_admin_prompt"
        android:textColor="#3E2723"
        android:textSize="14sp" />

</LinearLayout>

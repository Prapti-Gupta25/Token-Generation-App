<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="@drawable/gradient_bg">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Select a Place"
        android:textColor="#1A237E"
        android:textSize="36sp"
        android:textStyle="bold"
        tools:ignore="HardcodedText" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Place 1 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/placeCard1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:foreground="?attr/selectableItemBackground"
                app:cardElevation="8dp"
                app:cardCornerRadius="20dp"
                app:contentPadding="20dp"
                app:cardBackgroundColor="#4A148C">

                <TextView
                    android:id="@+id/placeName1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RTO Office"
                    android:textSize="20sp"
                    android:textColor="@android:color/white"
                    tools:ignore="HardcodedText" />
            </androidx.cardview.widget.CardView>

            <!-- Place 2 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/placeCard2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardElevation="8dp"
                app:cardCornerRadius="20dp"
                app:contentPadding="20dp"
                app:cardBackgroundColor="#4A148C">

                <TextView
                    android:id="@+id/placeName2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="K.k. Wagh Canteen"
                    android:textSize="20sp"
                    android:textColor="@android:color/white"
                    tools:ignore="HardcodedText" />
            </androidx.cardview.widget.CardView>

            <!-- Place 3 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/placeCard3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardElevation="8dp"
                app:cardCornerRadius="20dp"
                app:contentPadding="20dp"
                app:cardBackgroundColor="#4A148C">

                <TextView
                    android:id="@+id/placeName3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trimbakeshwar Temple"
                    android:textSize="20sp"
                    android:textColor="@android:color/white"
                    tools:ignore="HardcodedText" />
            </androidx.cardview.widget.CardView>

            <!-- Place 4 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/placeCard4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardElevation="8dp"
                app:cardCornerRadius="20dp"
                app:contentPadding="20dp"
                app:cardBackgroundColor="#4A148C">

                <TextView
                    android:id="@+id/placeName4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cafe"
                    android:textSize="20sp"
                    android:textColor="@android:color/white"
                    tools:ignore="HardcodedText" />
            </androidx.cardview.widget.CardView>

            <!-- Place 5 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/placeCard5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardElevation="8dp"
                app:cardCornerRadius="20dp"
                app:contentPadding="20dp"
                app:cardBackgroundColor="#4A148C">

                <TextView
                    android:id="@+id/placeName5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sahyadri Hospital"
                    android:textSize="20sp"
                    android:textColor="@android:color/white"
                    tools:ignore="HardcodedText" />
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/continueBtn"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="355dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:backgroundTint="@color/teal_700"
        android:minHeight="70dp"
        android:text="Continue"
        app:cornerRadius="20dp"
        android:layout_marginBottom="@android:dimen/app_icon_size"
        android:textSize="18sp"
        tools:ignore="HardcodedText,VisualLintButtonSize" />

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@drawable/gradient_bg"
    android:padding="24dp"
    tools:context=".TokenBookingActivity">

    <!-- Selected Place -->
    <TextView
        android:id="@+id/placeNameText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Selected Place"
        android:textColor="@android:color/white"
        android:textSize="42sp"
        android:textStyle="bold"
        android:layout_marginBottom="60dp"
        tools:ignore="HardcodedText" />

    <!-- Token Box -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:background="@drawable/token_box_bg"
        android:gravity="center"
        android:layout_marginBottom="50dp">

        <TextView
            android:id="@+id/tokenDisplay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your Token: -"
            android:textColor="#1B5E20"
            android:textSize="22sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />
    </LinearLayout>

    <!-- Get Token Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/generateTokenBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Get Token"
        android:textAllCaps="false"
        android:textSize="18sp"
        android:backgroundTint="@color/teal_700"
        android:textColor="@android:color/white"
        android:minHeight="54dp"
        android:elevation="8dp"
        app:cornerRadius="16dp"
        style="@style/Widget.MaterialComponents.Button"
        tools:ignore="HardcodedText,VisualLintButtonSize" />



</LinearLayout>
